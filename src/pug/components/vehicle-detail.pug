section(class='vehicle-detail' data-vehicle-detail)
	div(class='main-container vehicle-detail__shell')
		div(class='container vehicle-detail__container')
			div(class='vehicle-detail__loading' data-detail-loading) Cargando vehículo…
			div(class='vehicle-detail__empty' data-detail-empty hidden)
				p(class='vehicle-detail__empty-text') No encontramos este vehículo.
				a(class='vehicle-detail__empty-link' href='./vehiculos.html') Volver al listado
			div(class='vehicle-detail__content' data-detail-content hidden)
				div(class='vehicle-detail__gallery vehicle-gallery-slider')
					div(class='swiper vehicle-detail__swiper')
						div(class='swiper-wrapper' data-detail-gallery)
						div(class='swiper-button-prev')
						div(class='swiper-button-next')
						div(class='swiper-pagination')
					div(class='swiper vehicle-detail__thumbs')
						div(class='swiper-wrapper' data-detail-thumbs)
				div(class='vehicle-detail__info')
					div(class='vehicle-detail__badges')
						span(class='vehicle-detail__badge' data-detail-condition)
						span(class='vehicle-detail__badge vehicle-detail__badge--premium' data-detail-premium hidden) Destacado
					h1(class='vehicle-detail__title' data-detail-title)
					p(class='vehicle-detail__price' data-detail-price)
					table(class='vehicle-detail__table')
						caption(class='vehicle-detail__table-caption') Especificaciones
						tbody
							tr
								th(class='vehicle-detail__th' scope='row') Año
								td(class='vehicle-detail__td' data-detail-year)
							tr
								th(class='vehicle-detail__th' scope='row') Km
								td(class='vehicle-detail__td' data-detail-mileage)
							tr
								th(class='vehicle-detail__th' scope='row') Combustible
								td(class='vehicle-detail__td' data-detail-fuel)
							tr
								th(class='vehicle-detail__th' scope='row') Transmisión
								td(class='vehicle-detail__td' data-detail-transmission)
							tr
								th(class='vehicle-detail__th' scope='row') Color
								td(class='vehicle-detail__td' data-detail-color)
							tr
								th(class='vehicle-detail__th' scope='row') Carrocería
								td(class='vehicle-detail__td' data-detail-body)
							tr
								th(class='vehicle-detail__th' scope='row') Provincia
								td(class='vehicle-detail__td' data-detail-location)
					div(class='vehicle-detail__actions')
						button(class='vehicle-detail__fav' type='button' data-detail-fav) Favorito
						a(class='vehicle-detail__contact' href='#' data-detail-contact target='_blank' rel='noopener noreferrer') Contactar por WhatsApp
				div(class='vehicle-detail__tabs' data-detail-tabs)
					div(class='vehicle-detail__tablist' role='tablist')
						button(class='vehicle-detail__tab is-active' type='button' role='tab' aria-selected='true' data-tab='description') Descripción
						button(class='vehicle-detail__tab' type='button' role='tab' aria-selected='false' data-tab='maintenance') Mantenimientos
						button(class='vehicle-detail__tab' type='button' role='tab' aria-selected='false' data-tab='seller') Vendedor
					div(class='vehicle-detail__panel is-active' role='tabpanel' data-panel='description')
						p(data-detail-description)
					div(class='vehicle-detail__panel' role='tabpanel' data-panel='maintenance' hidden)
						include maintenance-list
					div(class='vehicle-detail__panel' role='tabpanel' data-panel='seller' hidden)
						div(class='vehicle-detail__seller' data-detail-seller)
				include similar-cars-slider
			a(
				class='vehicle-detail__sticky-wa'
				href='#'
				data-detail-sticky-wa
				hidden
				target='_blank'
				rel='noopener noreferrer'
			) Contactar por WhatsApp
