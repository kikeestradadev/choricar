section(class='vehicle-grid' data-vehicle-grid)
	div(class='vehicle-grid__toolbar')
		p(class='vehicle-grid__count' aria-live='polite' data-grid-count) Cargando vehículos…
	div(class='vehicle-grid__list' data-grid-list aria-live='polite')
	div(class='pagination' data-pagination)
		button(class='pagination__btn' type='button' data-page-prev aria-label='Página anterior') Anterior
		span(class='pagination__info' data-page-info) 1 / 1
		button(class='pagination__btn' type='button' data-page-next aria-label='Página siguiente') Siguiente
